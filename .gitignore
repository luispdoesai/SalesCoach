# PRIVACY RULES. Do not remove these.
# Your calls, keys, and personal rubric must never be committed.
/data/
.env
.env.*
!.env.example
# Everything in rubric/ is private except the shareable example.
rubric/*
!rubric/rubric.example.md
*.db

